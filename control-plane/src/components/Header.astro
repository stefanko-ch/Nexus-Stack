---
import { stackLabel } from '../lib/stack-identity';

interface Props {
  activeNav?: string;
}

const { activeNav = '' } = Astro.props;

const navItems = [
  { href: '/', label: 'Dashboard', id: 'dashboard' },
  { href: '/stacks', label: 'Stacks', id: 'stacks' },
  { href: '/monitoring', label: 'Monitoring', id: 'monitoring' },
  { href: '/secrets', label: 'Secrets', id: 'secrets' },
  { href: '/firewall', label: 'Firewall', id: 'firewall' },
  { href: '/settings', label: 'Settings', id: 'settings' },
  { href: '/integrations', label: 'Integrations', id: 'integrations' },
];
---

<header>
  <div class="logo" role="img" aria-label="Nexus Stack"></div>
  <h1>{stackLabel || 'NEXUS STACK'}</h1>
  <p class="tagline">
    {stackLabel && <>Nexus Stack &middot; </>}Control Panel &middot; <span id="version-tag" class="version-tag"></span>
  </p>
  <nav class="nav-links">
    {navItems.map(item => (
      <a href={item.href} class={activeNav === item.id ? 'active' : ''}>
        {item.label}
      </a>
    ))}
  </nav>
</header>

<script>
  async function fetchVersion() {
    try {
      const r = await fetch('/api/version', { credentials: 'same-origin' });
      if (r.ok) {
        const d = await r.json();
        const t = document.getElementById('version-tag');
        if (t && d.version) t.textContent = d.version;
      }
    } catch {}
  }
  fetchVersion();
</script>

<style>
  /* Reads `--accent` directly. Part B of #841 introduced a local
     `--header-accent` because only the header followed the stack accent;
     part A moved the override onto `<html>`, so keeping it would be a
     variable pointing at a variable.

     `color-mix` rather than `rgba(0, 255, 136, …)`: a hex custom property
     cannot be alpha-composed directly, and the alternative — a companion
     `--accent-rgb` — would make the operator supply the colour twice, in
     two notations. */
  header {
    text-align: center;
    border-bottom: none;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
  }

  /* The logo is painted, not drawn: a box filled with the accent, masked to
     the artwork's silhouette. So it recolours with the rest of the header
     instead of staying green on a violet panel (#841).

     The alternative in the issue was `filter: hue-rotate()`, which ties the
     result to the source hue and degrades on accents far from the original
     green; this is exact for any accent. The mask comes from the old raster
     itself — bright green on a near-black ground, so its own brightness is
     the silhouette — via scripts/build-logo-mask.py. As a side effect the
     header stopped shipping 6.58 MB for a 360px image: the mask is 107 KB.

     `aspect-ratio` replaces the intrinsic size an <img> used to supply; a
     masked <div> has none, and without it the box collapses to zero height. */
  .logo {
    display: block;
    width: 360px;
    max-width: 100%;
    aspect-ratio: 3168 / 1344;
    margin: 0 auto 1.5rem;
    background-color: var(--accent);
    -webkit-mask: url(/nexus-logo-mask.png) center / contain no-repeat;
    mask: url(/nexus-logo-mask.png) center / contain no-repeat;
    filter: drop-shadow(0 0 20px color-mix(in srgb, var(--accent) 50%, transparent));
  }

  /* The largest text on the page names the machine. With STACK_LABEL unset
     this is the literal "NEXUS STACK" it has always been; with it set, the
     stack's own name takes the slot, and "Nexus Stack" moves down into the
     tagline. Uppercasing is what keeps a lowercase label from looking like
     a mistake next to the Orbitron letter-spacing. */
  h1 {
    color: var(--accent);
    font-family: 'Orbitron', sans-serif;
    font-size: 2.5rem;
    text-shadow:
      0 0 10px color-mix(in srgb, var(--accent) 80%, transparent),
      0 0 40px color-mix(in srgb, var(--accent) 40%, transparent);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .tagline {
    font-size: 0.85rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.3em;
    opacity: 0.7;
  }

  .version-tag {
    font-size: 0.75rem;
    color: var(--accent);
    opacity: 0.5;
    letter-spacing: 0.1em;
  }

  .nav-links {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1rem;
  }

  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.8rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    transition: all 0.3s;
  }

  .nav-links a:hover {
    color: var(--text-secondary);
    border-color: var(--text-muted);
  }

  .nav-links a.active {
    color: var(--accent);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
</style>
