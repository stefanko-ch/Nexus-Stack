---
import { stackLabel, stackAccent } from '../lib/stack-identity';

interface Props {
  activeNav?: string;
}

const { activeNav = '' } = Astro.props;

const navItems = [
  { href: '/', label: 'Dashboard', id: 'dashboard' },
  { href: '/stacks', label: 'Stacks', id: 'stacks' },
  { href: '/monitoring', label: 'Monitoring', id: 'monitoring' },
  { href: '/secrets', label: 'Secrets', id: 'secrets' },
  { href: '/firewall', label: 'Firewall', id: 'firewall' },
  { href: '/settings', label: 'Settings', id: 'settings' },
  { href: '/integrations', label: 'Integrations', id: 'integrations' },
];
---

<header style={stackAccent ? `--header-accent: ${stackAccent}` : undefined}>
  <img src="/nexus-logo-green.png" alt="Nexus Stack" class="logo">
  <h1>{stackLabel || 'NEXUS STACK'}</h1>
  <p class="tagline">
    {stackLabel && <>Nexus Stack &middot; </>}Control Panel &middot; <span id="version-tag" class="version-tag"></span>
  </p>
  <nav class="nav-links">
    {navItems.map(item => (
      <a href={item.href} class={activeNav === item.id ? 'active' : ''}>
        {item.label}
      </a>
    ))}
  </nav>
</header>

<script>
  async function fetchVersion() {
    try {
      const r = await fetch('/api/version', { credentials: 'same-origin' });
      if (r.ok) {
        const d = await r.json();
        const t = document.getElementById('version-tag');
        if (t && d.version) t.textContent = d.version;
      }
    } catch {}
  }
  fetchVersion();
</script>

<style>
  /* Every brand-green in this header routes through one variable, so a
     stack accent recolours the whole block rather than one badge. The
     fallback is the panel's own accent, so with STACK_ACCENT unset every
     rule below resolves to exactly what it was before.

     `color-mix` replaces the previous `rgba(0, 255, 136, …)` literals:
     a hex custom property cannot be alpha-composed directly, and the
     alternative — carrying a companion `--header-accent-rgb` — would need
     the operator to supply the colour twice, in two notations. */
  header {
    --header-accent: var(--accent);
    text-align: center;
    border-bottom: none;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
  }

  .logo {
    display: block;
    width: 360px;
    max-width: 100%;
    height: auto;
    margin: 0 auto 1.5rem;
    /* ⚠️ The logo itself is a raster with the green baked in, so on a
       recoloured panel only its glow follows the accent. Issue #841 tracks
       the choice between a neutral logo variant and a hue-rotate. */
    filter: drop-shadow(0 0 20px color-mix(in srgb, var(--header-accent) 50%, transparent));
  }

  /* The largest text on the page names the machine. With STACK_LABEL unset
     this is the literal "NEXUS STACK" it has always been; with it set, the
     stack's own name takes the slot, and "Nexus Stack" moves down into the
     tagline. Uppercasing is what keeps a lowercase label from looking like
     a mistake next to the Orbitron letter-spacing. */
  h1 {
    color: var(--header-accent);
    font-family: 'Orbitron', sans-serif;
    font-size: 2.5rem;
    text-shadow:
      0 0 10px color-mix(in srgb, var(--header-accent) 80%, transparent),
      0 0 40px color-mix(in srgb, var(--header-accent) 40%, transparent);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .tagline {
    font-size: 0.85rem;
    color: var(--header-accent);
    text-transform: uppercase;
    letter-spacing: 0.3em;
    opacity: 0.7;
  }

  .version-tag {
    font-size: 0.75rem;
    color: var(--header-accent);
    opacity: 0.5;
    letter-spacing: 0.1em;
  }

  .nav-links {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1rem;
  }

  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.8rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    transition: all 0.3s;
  }

  .nav-links a:hover {
    color: var(--text-secondary);
    border-color: var(--text-muted);
  }

  .nav-links a.active {
    color: var(--header-accent);
    border-color: var(--header-accent);
    background: color-mix(in srgb, var(--header-accent) 8%, transparent);
  }
</style>
