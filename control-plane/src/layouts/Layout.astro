---
import { stackLabel, stackAccent } from '../lib/stack-identity';
import Header from '../components/Header.astro';
import Toast from '../components/Toast.astro';
import StacksShared from '../components/StacksShared.astro';
import PendingBar from '../components/PendingBar.astro';
import ShortcutsHelp from '../components/ShortcutsHelp.astro';
import ApiOnlyModal from '../components/ApiOnlyModal.astro';
import '../styles/global.css';

interface Props {
  title: string;
  activeNav?: string;
  narrow?: boolean;
}

const { title, activeNav = '', narrow = false } = Astro.props;
---

<!DOCTYPE html>
{/* The accent lands on <html>, so every `var(--accent)` in the panel
    follows it — that is the whole point of part A of #841. Status colours
    deliberately do NOT: they read `--status-ok`, which stays green so a
    healthy stack looks healthy whatever the accent is.

    Gated on the label for the same reason the header was: an accent with no
    name on the panel is a stack that looks different for no stated reason. */}
<html lang="en" style={stackLabel && stackAccent ? `--accent: ${stackAccent}` : undefined}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{stackLabel ? `[${stackLabel}] ` : ''}{title} - Nexus Control Plane</title>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Orbitron:wght@700&display=swap" rel="stylesheet">
</head>
<body>
  <!-- Shared helpers load first so page scripts can call window.NS.* / showToast during init -->
  <Toast />
  <StacksShared />
  <div class={narrow ? 'container-narrow' : 'container'}>
    <Header activeNav={activeNav} />
    <PendingBar />
    <slot />
    <footer>
      <p>Built with lots of coffee by <a href="https://github.com/stefanko-ch" target="_blank" rel="noopener noreferrer">Stefan</a></p>
      <p>Powered by <a href="https://github.com/stefanko-ch/Nexus-Stack" target="_blank" rel="noopener noreferrer">Nexus-Stack</a></p>
    </footer>
  </div>
  <ShortcutsHelp />
  <ApiOnlyModal />
</body>
</html>
