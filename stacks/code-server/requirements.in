# Top-level packages of the code-server nexus-venv. requirements.txt is
# the full pinned set compiled from this file; the Dockerfile installs
# that one.
dbt-core
dbt-postgres
dbt-duckdb
dbt-clickhouse
dbt-spark
dbt-trino
dbt-databricks
jupyterlab
jupysql
polars
plotly
duckdb
# SQLAlchemy 2.1 resolves a bare postgresql:// URL to psycopg 3, and
# dbt-postgres brings only psycopg2-binary, so without this a student's
# create_engine("postgresql://...") or %sql postgresql://... fails with
# "No module named 'psycopg'".
psycopg[binary]
